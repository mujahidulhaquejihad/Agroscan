[Unit]
Description=AgroScan API (Gemini RAG + local vision)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/agroscan
EnvironmentFile=-/opt/agroscan/.env
Environment=PYTHONUNBUFFERED=1
Environment=AGROSCAN_LLM_LOCAL=0
Environment=AGROSCAN_LLM_PRELOAD=0
Environment=AGROSCAN_LLM_ENABLED=1
Environment=AGROSCAN_GEMINI=1
Environment=AGROSCAN_LLM_MAX_NEW=1024
ExecStart=/opt/agroscan/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
