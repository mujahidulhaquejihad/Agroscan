# Copy to .env and fill in. Never commit .env.
AGROSCAN_GEMINI=1
GEMINI_API_KEY=
AGROSCAN_GEMINI_MODEL=gemini-flash-latest
AGROSCAN_LLM_ENABLED=1
# Keep 0 on the home server (CPU). Set 1 only on the GPU PC for Gemma.
AGROSCAN_LLM_LOCAL=0
AGROSCAN_LLM_PRELOAD=0
AGROSCAN_LLM_MAX_NEW=4096

# Admin panel (/admin) — password is the token
AGROSCAN_ADMIN_USER=admin
AGROSCAN_ADMIN_TOKEN=agroscan-admin

# Vendor panel (/vendor) — created on first boot if missing
AGROSCAN_VENDOR_USER=vendor
AGROSCAN_VENDOR_PASSWORD=agroscan-vendor
