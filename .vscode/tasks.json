    },
    {
      "label": "AgroScan: Smoke test LoRA (5 steps)",
      "type": "shell",
      "command": "C:\\Users\\User\\AppData\\Local\\Programs\\Python\\Python312\\python.exe",
      "args": [
        "-m", "llm.train_lora",
        "--model", "Qwen/Qwen2.5-1.5B-Instruct",
        "--max-steps", "5",
        "--batch-size", "1",
        "--grad-accum", "4",
        "--max-seq-len", "512",
        "--gradient-checkpointing",
