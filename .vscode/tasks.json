        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "AgroScan: Train 1.5B LoRA (full)",
      "type": "shell",
      "command": "C:\\Users\\User\\AppData\\Local\\Programs\\Python\\Python312\\python.exe",
